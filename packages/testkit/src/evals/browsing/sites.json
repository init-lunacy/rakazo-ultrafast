  "article": {
    "title": "The Kestrel Ridge Trail",
    "sections": [
      {
        "heading": "Overview",
        "text": "The Kestrel Ridge trail climbs 900 metres over twelve kilometres of mixed forest and open ridge. Most walkers finish it in five to six hours."
      },
      {
        "heading": "Getting there",
        "text": "The trailhead car park fills early on weekends. A seasonal bus runs from the valley station every ninety minutes."
      },
      {
        "heading": "The forest section",
        "text": "The first four kilometres follow an old logging road, widened in 1955 when the sawmill reopened."
      },
      {
        "heading": "The ridge",
        "text": "Above the tree line the path is exposed. Check the forecast; afternoon storms are common in summer."
      },
      {
        "heading": "The hut",
        "text": "A stone hut built in 1902 offers shelter halfway along the ridge. It has no water source."
      },
      {
        "heading": "Wildlife",
        "text": "Kestrels nest on the southern cliffs from April to July, which gave the ridge its name."
      },
      {
        "heading": "Seasons",
        "text": "Snow can linger on the north side into June. Autumn brings the clearest views."
      },
      {
        "heading": "Safety",
        "text": "Carry a map and a headlamp. Phone coverage drops out between the hut and the summit cairn."
      }
    ],
    "lateSection": {
      "heading": "History",
      "text": "Surveyors first mapped the Kestrel Ridge trail in 1887, following a shepherds' route between the two valleys."
    },
    "factYear": "1887",
    "lateDelayMs": 3000
  }
